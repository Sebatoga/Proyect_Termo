{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "ecogrid-director",
  "share": "disabled",
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "edit": "allow",
    "shell": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git push*": "deny",
      "git commit*": "ask",
      "rm *": "deny",
      "del *": "deny",
      "rmdir *": "deny"
    },
    "task": "allow",
    "skill": "allow",
    "external_directory": "deny",
    "webfetch": "ask",
    "websearch": "ask"
  }
}
